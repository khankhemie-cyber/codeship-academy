# ============================================================
# CODEship Academy — Environment Variables
# Copy this file to .env.local for local development.
# Set all variables in Vercel / Cloudflare dashboard for prod.
# ============================================================

# ------------------------------------------------------------
# Supabase — https://app.supabase.com → Settings → API
# ------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...          # safe to expose (RLS enforced)
SUPABASE_SERVICE_ROLE_KEY=eyJ...              # NEVER expose — server-side only

# Direct Postgres connection (for npm run db:push) — Supabase → Settings → Database → URI
# Use the "Session pooler" or direct connection string; include ?sslmode=require if needed
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ------------------------------------------------------------
# Anthropic — https://console.anthropic.com → API Keys
# CRITICAL: never prefix with NEXT_PUBLIC_ — server-side only
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# Stripe — https://dashboard.stripe.com → Developers → API Keys
# ------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...   # safe to expose
STRIPE_SECRET_KEY=sk_live_...                    # NEVER expose
STRIPE_WEBHOOK_SECRET=whsec_...                  # from stripe listen --forward-to

# Stripe Price IDs — create in Products dashboard
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
STRIPE_PRICE_FAMILY=price_...
STRIPE_PRICE_TEACHER=price_...
STRIPE_PRICE_SESSIONS_5=price_...
STRIPE_PRICE_SESSIONS_10=price_...
STRIPE_PRICE_SESSIONS_20=price_...
STRIPE_PRICE_SCHOOL_MONTHLY=price_...
STRIPE_PRICE_SCHOOL_ANNUAL=price_...

# ------------------------------------------------------------
# Resend — https://resend.com → API Keys
# ------------------------------------------------------------
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@codeshipacademy.com           # must be verified domain in Resend

# ------------------------------------------------------------
# App — public URL (no trailing slash)
# ------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.codeshipacademy.com

# ------------------------------------------------------------
# Cron — sign weekly-digest cron requests so only Vercel can trigger
# Generate: openssl rand -hex 32
# ------------------------------------------------------------
CRON_SECRET=your-64-char-hex-secret
